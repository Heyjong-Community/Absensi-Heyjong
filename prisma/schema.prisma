generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id @default(uuid())
  nama      String     @db.VarChar(255)
  role      RoleUser   @default(Pengurus)
  username  String     @unique @db.VarChar(255)
  password  String     @db.VarChar(255)
  status    StatusUser @default(Aktif)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  accounts  Account[]
  events    Event[]
  sessions  Session[]
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id                 String       @id @default(uuid())
  nama               String       @db.VarChar(255)
  slug               String       @db.VarChar(255)
  tanggalPelaksanaan DateTime     @db.Timestamptz(6)
  tanggalSelesai     DateTime     @db.Timestamptz(6)
  lokasi             String?      @db.VarChar(255)
  deskripsi          String?
  isActive           Boolean      @default(true)
  createdBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  attendances        Attendance[]
  user               User?        @relation(fields: [createdBy], references: [id])
}

model Attendance {
  id        String       @id @default(uuid())
  eventId   String
  nama      String       @db.VarChar
  status    StatusPeople @default(Member)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  event     Event        @relation(fields: [eventId], references: [id])

  @@unique([eventId, nama])
}

model Member {
  id          String       @id @default(uuid())
  namaLengkap String       @db.VarChar(255)
  panggilan   String       @db.VarChar(255)
  gender      Gender       @default(LakiLaki)
  status      StatusPeople @default(Member)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum RoleUser {
  SuperAdmin
  Admin
  Pengurus
  Staff
  Member
  Volunteer
}

enum StatusUser {
  Aktif
  NonAktif
}

enum StatusPeople {
  Manajemen
  Pengurus
  Staff
  Member
  Volunteer
}

enum Gender {
  LakiLaki
  Perempuan
}
